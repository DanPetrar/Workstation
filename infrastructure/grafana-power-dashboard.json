            "query": "import \"date\"\ndata = from(bucket:\"zaxenergy\")\n  |> range(start: date.sub(d: 2m, from: v.timeRangeStart), stop: v.timeRangeStop)\n  |> filter(fn:(r) => r._measurement == \"energy\" and r.unit == \"${unit}\" and (r._field == \"kwh\" or r._field == \"kwh_exp\"))\n  |> group(columns: [\"phase\", \"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> difference(nonNegative: true)\n  |> filter(fn:(r) => r._time >= v.timeRangeStart)\n  |> sum()\nd = data\ntot = d |> group(columns: [\"_field\"]) |> sum() |> map(fn:(r) => ({r with phase: \"total\"}))\nunion(tables: [d, tot])\n  |> group()\n  |> pivot(rowKey: [\"phase\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"phase\", \"kwh\", \"kwh_exp\"])\n  |> sort(columns: [\"phase\"])",
